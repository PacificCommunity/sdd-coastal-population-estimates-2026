// Import datasets
var mainlands = ee.FeatureCollection('projects/sat-io/open-datasets/shoreline/mainlands');
var big_islands = ee.FeatureCollection('projects/sat-io/open-datasets/shoreline/big_islands');
var small_islands = ee.FeatureCollection('projects/sat-io/open-datasets/shoreline/small_islands');

// Merge shorelines
var merged = mainlands.merge(big_islands).merge(small_islands);

// Define extents manually (for each country)
var extents = {
  'ASM': ee.Geometry.Rectangle([-171.1, -14.54, -168.14, -11.04]),  // American Samoa
  'COK': ee.Geometry.Rectangle([-165.85, -21.9, -157.32, -8.95]),  // Cook Islands
  'FSM': ee.Geometry.Rectangle([137.0, 0.0, 164.0, 13.0]),   // Federated States of Micronesia
  'GUM': ee.Geometry.Rectangle([144.5, 13.2, 145.0, 13.7]),  // Guam
  'MHL': ee.Geometry.Rectangle([162.3, 4.55, 180.0, 14.0]),   // Marshall Islands
  'MNP': ee.Geometry.Rectangle([144.5, 14.0, 146.5, 15.5]),  // Northern Mariana Islands
  'NCL': ee.Geometry.Rectangle([159.0, -22.5, 169.0, -20.0]), // New Caledonia
  'NIU': ee.Geometry.Rectangle([-170.0, -19.0, -169.5, -18.0]), // Niue
  'NRU': ee.Geometry.Rectangle([166.9, -0.6, 167.8, -0.4]),  // Nauru
  'PLW': ee.Geometry.Rectangle([131.12, 2.97, 134.7, 8.09]),    // Palau
 // 'PNG': ee.Geometry.Rectangle([141.0, -11.5, 157.0, -3.5]), // Papua New Guinea made apart
  'PYF': ee.Geometry.Rectangle([-154.72, -27.9, -134.0, -7.85]), // French Polynesia
  'SLB': ee.Geometry.Rectangle([145.51, -12.3, 169.85, -3]), // Solomon Islands go beyond to avoid missing chunk line
  'TON': ee.Geometry.Rectangle([-175.6, -21.4, -173.72, -15.55]), // Tonga
  'TUV': ee.Geometry.Rectangle([176.1, -10.8, 179.82, -5.6]),  // Tuvalu
  'VUT': ee.Geometry.Rectangle([166.5, -20.25, 170.23, -13.0]), // Vanuatu
  'WLF': ee.Geometry.Rectangle([-178.19, -14.32, -176.15, -13.2]), // Wallis and Futuna
  'WSM': ee.Geometry.Rectangle([-173.0, -14.0, -171.5, -13.0]), // Samoa
  'FJI': ee.Geometry.Rectangle([177.0, -21.5, -176.0, -12.0]), // Fiji
  'KIR': ee.Geometry.Rectangle([168.0, -6.8, -150, 5.0])    // Kiribati
};

// Loop over the extents
Object.keys(extents).forEach(function (iso3) {
  var countryExtent = extents[iso3]; // Get the extent for the country

  // Clip the shorelines to the country's extent
  var mergedClipped = merged.filterBounds(countryExtent);

  // Add the result to the map for visualization
  Map.addLayer(mergedClipped, {color: 'green'}, iso3 + ' Shorelines');

  // Export the merged shorelines
  Export.table.toDrive({
    collection: mergedClipped,
    description: iso3 + '_shorelines',
    fileFormat: 'GeoJSON',
    folder: 'Pacific_Shorelines'
  });

  print('Exporting shorelines for', iso3, mergedClipped);
});

// Center the map for visualization
Map.setCenter(-170.8, -14.0, 6);